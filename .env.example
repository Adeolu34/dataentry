# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/data_entry_bot

# Redis
REDIS_URL=redis://redis:6379/0

# Portal configuration
PORTAL_URL=https://your-portal.example.com
PORTAL_USER=portal_username
PORTAL_PASS=portal_password
PORTAL_NAME=MyPortal

# Directories
INPUT_FILES_DIR=/app/input_files
RECEIPTS_DIR=/app/receipts
SCREENSHOTS_DIR=/app/screenshots

# Logging
LOG_LEVEL=INFO

# SMTP alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
ALERT_EMAIL=alerts@example.com

# Bot behaviour
MAX_RETRIES=3
RETRY_DELAY_SECONDS=5
HEADLESS_BROWSER=true
BATCH_SIZE=50
